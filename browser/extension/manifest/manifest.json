{
  "manifest_version": 3,
  "name": "PerRoute",
  "version": "1.0.0",
  "description": "Route this browser through VLESS, VMess, Trojan or Shadowsocks servers, and choose site by site what uses the tunnel. By Ali Mirzad.",
  "author": "Ali Mirzad",
  "minimum_chrome_version": "116",
  "permissions": ["proxy", "storage", "nativeMessaging", "activeTab", "privacy", "webRequest", "webRequestAuthProvider", "alarms", "notifications"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "PerRoute",
    "default_popup": "popup.html",
    "default_icon": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png" }
  },
  "options_ui": {
    "page": "dashboard.html",
    "open_in_tab": true
  },
  "icons": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; connect-src 'self' data:; base-uri 'none'; frame-ancestors 'none'"
  }
}
